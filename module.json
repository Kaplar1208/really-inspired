        }
      }
    ],
    "recommends": [
      {
        "id": "tidy5e-sheet",
        "type": "module",
        "reason": "Optional: if active (quadrone theme), the inspiration counter is shown through Tidy5e's own banked-inspiration UI instead of the default dnd5e sheet widget."
      }
    ]
  },
